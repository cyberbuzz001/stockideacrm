<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_inherit_stockidea" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.stockidea</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_create_upsell" type="object" class="oe_stat_button" icon="fa-usd">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_text">One-Click</span>
                        <span class="o_stat_text">Upsell</span>
                    </div>
                </button>
            </xpath>

            <xpath expr="//notebook" position="inside">
                <page string="Financial Ledger">
                     <!-- Simple view of Invoices/Payments -->
                    <field name="invoice_ids" readonly="1">
                        <tree string="Ledger">
                            <field name="name"/>
                            <field name="invoice_date"/>
                            <field name="amount_total"/>
                            <field name="payment_state"/>
                            <field name="state"/>
                        </tree>
                    </field>
                </page>
                <page string="Compliance (KYC)">
                    <group>
                        <group string="Identity Documents">
                            <field name="pan_card"/>
                            <field name="pan_card_file" filename="pan_card"/>
                            <field name="aadhaar_card"/>
                            <field name="aadhaar_card_file" filename="aadhaar_card"/>
                        </group>
                        <group string="Status">
                            <field name="kyc_status" widget="statusbar" options="{'clickable': '1'}"/>
                            <field name="risk_profile_id"/>
                        </group>
                    </group>
                    <group string="Search Shortcuts">
                        <field name="alt_phone_1"/>
                        <field name="alt_phone_2"/>
                    </group>
                </page>
            </xpath>
            
            <!-- Global Search Indexing Hint (Search View) -->
             <xpath expr="//field[@name='phone']" position="after">
                <field name="pan_card" filter_domain="[('pan_card', 'ilike', self)]"/>
                <field name="aadhaar_card" filter_domain="[('aadhaar_card', 'ilike', self)]"/>
                <field name="mobile" filter_domain="[('mobile', 'ilike', self)]"/>
            </xpath>
        </field>
    </record>

    <!-- Lead Search View Extension -->
    <record id="view_crm_case_leads_filter_inherit_stockidea" model="ir.ui.view">
        <field name="name">crm.lead.search.inherit.stockidea</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.view_crm_case_leads_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="demat_id"/>
                <field name="contact_name"/>
                <field name="mobile"/>
            </xpath>
        </field>
    </record>
</odoo>
