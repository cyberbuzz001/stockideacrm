# Evolution API Configuration File
# Copy this to deployment/.env.evolution and fill in real values.
# deployment/.env.evolution is gitignored — never commit it.
PORT=8080
URL=http://localhost:8080

# API Security
AUTHENTICATION_TYPE=apikey
AUTHENTICATION_API_KEY=change_me_to_a_long_random_secret

# DB Configuration
DATABASE_ENABLED=true
DATABASE_PROVIDER=postgresql
DATABASE_CONNECTION_URI=postgresql://evolution:change_me_to_a_strong_password@postgres:5432/evolution?schema=public
DATABASE_SAVE_DATA_INSTANCE=true
DATABASE_SAVE_DATA_NEW_MESSAGE=true
DATABASE_SAVE_MESSAGE_CONN=true
DATABASE_SAVE_DATA_CONTACTS=true
DATABASE_SAVE_DATA_CHATS=true

# Redis Cache
CACHE_REDIS_ENABLED=true
CACHE_REDIS_URI=redis://redis:6379/0
CACHE_REDIS_TTL_INSTANCES=86400

# Server / Instance settings
USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36"

# Must match DATABASE_CONNECTION_URI's password above — used by docker-compose.yml
POSTGRES_PASSWORD=change_me_to_a_strong_password
